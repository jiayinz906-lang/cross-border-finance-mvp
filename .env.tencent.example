# Copy to .env.tencent on the CVM, replace every CHANGE_ME value, then chmod 600 .env.tencent.
NODE_ENV=production
PRODUCTION_PROFILE=tencent

SERVER_NAME=finance.example.com
PUBLIC_APP_URL=https://finance.example.com/
VITE_API_BASE_URL=/api
TLS_CERT_HOST_DIR=./certs
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

POSTGRES_DB=xjd_finance
POSTGRES_USER=xjd_finance_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATA_DIR=/data/xjd-finance/postgres
# If POSTGRES_PASSWORD contains reserved URL characters, percent-encode it in DATABASE_URL.
DATABASE_URL=postgresql://xjd_finance_app:CHANGE_ME_URL_ENCODED@postgres:5432/xjd_finance?schema=public

AUTH_REQUIRE_TOKEN=true
ALLOW_HEADER_ROLE=false
ENABLE_LEGACY_DEFAULT_USERS=false
AUTH_TOKEN_SECRET=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS

CORS_ALLOWED_ORIGINS=https://finance.example.com
UPLOAD_MAX_MB=25
IMAGE_UPLOAD_MAX_MB=10
HTTP_REQUEST_TIMEOUT_MS=120000
SLOW_REQUEST_THRESHOLD_MS=2000
HEALTH_DB_TIMEOUT_MS=5000

MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="系统正在维护，请稍后重试"
MAINTENANCE_ALLOWED_IPS=

BACKUP_OUTPUT_DIR=/data/xjd-finance/backups
DB_BACKUP_OUTPUT_DIR=/data/xjd-finance/backups

COS_BACKUP_ENABLED=false
COS_BUCKET=
COS_REGION=
COS_PREFIX=xjd-finance/database
COSCLI_CONFIG_PATH=
COS_REQUIRE_SERVER_SIDE_ENCRYPTION=true

BACKEND_IMAGE_NAME=xjd-finance-backend
FRONTEND_IMAGE_NAME=xjd-finance-frontend
IMAGE_TAG=local
BUILD_GIT_SHA=local
BUILD_TIME=unknown
BACKEND_MEMORY_LIMIT=1g
BACKEND_CPU_LIMIT=1.0

FINANCE_TEST_USERNAME=
FINANCE_TEST_PASSWORD=
